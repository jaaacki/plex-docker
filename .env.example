# =============================================================================
# Plex Media Server
# =============================================================================
ADVERTISE_IP=http://192.168.2.198:32400/

# Plex authentication token
# Get from: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# Base URL for Plex watch links
PLEX_EXTERNAL_URL=https://your-plex-domain.com

# =============================================================================
# MCP-Plex Server
# =============================================================================
MCP_API_KEY=your_mcp_api_key_here
MCP_PLEX_PORT=9102

# =============================================================================
# Shared
# =============================================================================
PUID=1026
PGID=100
TZ=Asia/Singapore

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
